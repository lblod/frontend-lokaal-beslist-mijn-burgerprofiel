<AuToolbar @border="bottom" class="au-u-padding-bottom-none" as |Group|>
  <Group>
    <MultiTabs />
  </Group>
  <Group>
    <AuButton
      class="au-u-padding-right link-without-line action-sdk-color"
      @skin="link"
      @disabled={{this.isFiltersDisabled}}
      {{on "click" @onShowFiltersPage}}
    >Filter</AuButton>
  </Group>
</AuToolbar>
{{#if this.hasFilters}}
  <div class="filters-topbar-active-filters">
    <div id="reset-button">
      <AuButton
        @skin="link"
        {{on "click" @onFilterReset}}
        class="au-u-bold link-without-line"
      >Wis filters</AuButton>
      {{#if this.session.isAuthenticated}}
        {{#unless this.filterService.selectedSavedFilter}}
          <AuButton
            class="au-u-bold link-without-line"
            @skin="link"
            {{on "click" @onFilterSave}}
          >Filters Opslaan</AuButton>
        {{/unless}}
      {{/if}}
    </div>
    <AuHr class="au-u-1-1 au-u-margin-top-none" />
    <div class="pills">
      {{#if this.filterService.selectedSavedFilter}}
        <AuPill
          @actionIcon="cross"
          @actionText="close"
          id="saved-filter-pill"
          @onClickAction={{this.removeSavedFilter}}
        >{{this.filterService.selectedSavedFilter.name}}</AuPill>
      {{else}}
        {{#each this.filterValues as |keyValue|}}
          <AuPill
            @actionIcon="cross"
            @actionText="close"
            id={{keyValue.key}}
            @onClickAction={{fn this.removeFilter keyValue}}
          >{{keyValue.value}}</AuPill>
        {{/each}}
      {{/if}}

    </div>

  </div>
{{/if}}