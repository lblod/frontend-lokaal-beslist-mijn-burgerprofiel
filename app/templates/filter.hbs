{{page-title "Filter"}}
<AuToolbar
  @border="bottom"
  class="au-u-padding link-without-line action-sdk-color sticky-top au-u-padding-top-none au-u-padding-bottom-none"
  as |Group|
>
  <Group>
    <AuButton
      class="link-without-line action-sdk-color"
      @skin="link"
      {{on "click" this.closeFilters}}
    >Sluiten</AuButton>
  </Group>

  <Group>
    <AuDropdown
      @title="Opties"
      @alignment="right"
      class="action-sdk-color"
      @skin="naked"
      @icon="three-dots"
      @iconAlignment="right"
    >
      <AuButton
        class="au-u-padding link-without-line action-sdk-color border-bottom-light"
        @skin="link"
        {{on "click" this.toggleSaveFilterModal}}
      >Sla deze filter op</AuButton>
      <AuButton
        class="au-u-padding link-without-line action-sdk-color border-bottom-light"
        @skin="link"
        {{on "click" this.toggleShowFilterModal}}
      >Bekijk opgeslagen filters</AuButton>
      <AuButton
        class="au-u-padding link-without-line action-sdk-color border-top"
        @skin="link"
        {{on "click" this.resetFilters}}
      >Wis huidige filters</AuButton>
    </AuDropdown>
  </Group>
</AuToolbar>

<div
  class="c-interface__sidebar-main au-u-padding-left au-u-padding-right au-u-margin-top-large"
>
  {{#if this.isMunicipalitySelectorShown}}
    <Filters::SelectMultipleFilter
      class="au-u-margin-top"
      @id="municipality"
      @label="Kies één of meer besturen"
      @options={{this.governmentList.options}}
      @selected={{this.governmentList.selected}}
      @updateSelected={{this.updateSelectedGovernment}}
      @noMatchesMessage="Geen besturen gevonden"
      @searchField="label"
      @queryParam="gemeentes+provincies"
      @placeholder="Alle besturen"
    />
  {{/if}}
  <Filters::AdvancedInputSearch
    class={{if this.isMunicipalitySelectorShown "" "au-u-margin-top"}}
    @value={{this.filterService.filters.keyword}}
    @searchOnlyOnTitle={{this.filterService.filters.keywordSearchOnlyInTitle}}
    @onUpdateKeyword={{this.updateKeyword}}
  />
  <section class="au-u-flex au-u-flex--column">
    <AuLabel for="sort-on">Sorteren</AuLabel>
    <select
      id="sort-on"
      type="select"
      {{on "change" this.updateSorting}}
      class="au-c-input au-u-1-1"
    >
      <option value="desc" selected={{this.isFilterDescending}}>Nieuwste eerst</option>
      <option value="asc" selected={{this.isFilterAscending}}>Oudste eerst</option>
    </select>
  </section>
  <AuHr />
  <Filters::Address::AdressenSelector
    @id="address-search"
    @selected={{this.distanceList.selected}}
  />
  <Filters::SelectFilter
    @id="distance"
    @label="Afstand"
    @options={{this.model.distanceOptions}}
    @selected={{this.distanceList.selected}}
    @updateSelected={{this.updateDistance}}
    @queryParam="afstand"
    @allowClear={{true}}
    @searchEnabled={{false}}
    @placeholder="Alle afstanden"
    @searchField="label"
  />
  <Filters::SelectMultipleFilter
    @id="theme"
    @label="Thema"
    @options={{this.themaOptions}}
    @selected={{this.selectedThemes}}
    @updateSelected={{this.updateSelectedThemes}}
    @noMatchesMessage="Geen thema's gevonden"
    @searchField="label"
    @queryParam="thema"
    @placeholder="Alle thema's"
  />
  <Filters::DateRangeFilter
    @startQueryParam="begin"
    @endQueryParam="eind"
    @start={{this.startDate}}
    @end={{this.endDate}}
    @updateSelected={{this.updateSelectedDateRange}}
  />
  <Filters::SelectRadioButtonFilter
    @id="status"
    @label="Status agendapunten"
    @options={{this.model.agendaStatusOptions}}
    @selected={{this.status}}
    @updateSelected={{this.setStatus}}
    @queryParam="status"
    @allowClear={{false}}
    @searchEnabled={{false}}
    @placeholder="Alle agendapunten"
  />
  <AuHr />
  <section class="c-advanced-filter-holder">
    <Accordion
      @buttonLabel="GEAVANCEERDE FILTERS"
      @showBottomBorder={{false}}
      @isInitiallyOpen={{this.hasSelectedAdvancedFilters}}
    >
      <Filters::SelectMultipleCheckboxFilter
        @id="governing-body"
        @label="Bestuursorganen"
        @options={{this.governingBodyList.options}}
        @selected={{this.selectedBestuursorgaanIds}}
        @updateSelected={{this.updateSelectedGoverningBodyClassifications}}
        @searchField="label"
        @queryParam="bestuursorganen"
      />
    </Accordion>
  </section>
</div>
<div class="c-interface__sidebar-submit-buttons">
  <AuHr />
  <AuButton
    @skin="primary"
    @width="block"
    @disabled={{or this.isApplyingFilters this.filtersHaveErrors}}
    @loading={{this.isApplyingFilters}}
    @loadingMessage="hidden"
    @hideText={{this.isApplyingFilters}}
    {{on "click" this.goToOverview}}
  >
    {{this.showResultsText}}
  </AuButton>
</div>

<AuModalContainer />
<AuModal
  @modalOpen={{this.showSaveFilterModal}}
  @closable={{true}}
  @closeModal={{this.toggleSaveFilterModal}}
  @size={{this.size}}
  @padding={{this.padding}}
  @overflow={{this.overflow}}
>
  <:title>Filter opslaan</:title>
  <:body>
    <form>
      <AuLabel for="filter-name">Hoe wil je deze filter noemen?</AuLabel>
      <AuInput
        @value={{this.filterName}}
        @id="filter-name"
        @width="block"
        {{on "input" this.updateFilterName}}
      />
    </form>
  </:body>
  <:footer>
    <AuButton
      @skin="primary"
      @disabled={{or this.isSavingFilters (not this.filterName)}}
      @isLoading={{this.isSavingFilters}}
      {{on "click" this.saveFilters}}
    >
      Opslaan
    </AuButton>
  </:footer>
</AuModal>
<AuModal
  @modalOpen={{this.showFiltersModal}}
  @closable={{true}}
  @closeModal={{this.toggleShowFilterModal}}
  @size={{this.size}}
  @padding={{this.padding}}
  @overflow={{this.overflow}}
>
  <:title>Opgeslagen filters</:title>
  <:body>
    <div class="border-top">
      {{#if this.savedFilters.length}}

        <div
          class="au-u-margin-none au-u-padding-none au-u-flex au-u-flex--column au-u-flex--spaced-tiny"
        >
          {{#each this.savedFilters key="name" as |savedFilter index|}}
            <AuCard
              @size="small"
              @expandable={{true}}
              @isOpenInitially={{false}}
              as |c|
            >
              <c.header>
                <div class="au-u-1-1 au-u-flex au-u-flex--between">
                  <span class="au-u-h5">{{savedFilter.name}}</span>
                </div>
              </c.header>
              <c.content>
                <div
                  class="au-u-flex au-u-flex--column au-u-flex--start au-u-flex--vertical-start au-u-flex--spaced-small"
                >
                  <div
                    class="au-u-flex au-u-flex--between au-u-1-1 border-bottom-light au-u-padding-bottom-small"
                  >
                    <AuToggleSwitch
                      @alignment="right"
                      @checked={{savedFilter.notify}}
                      @name="notification-toggle-{{index}}"
                      @toggle="identifier"
                      {{on "change" (fn this.toggleNotification index)}}
                    >
                      Notificatie
                    </AuToggleSwitch>
                    <div
                      class="tooltip-wrapper au-u-flex au-u-margin-left-tiny au-u-flex--end au-u-flex--vertical-center"
                    >
                      <AuIcon @icon="circle-question" @size="large" />
                      <EmberTooltip
                        @text="Als je deze optie activeert, ontvang je een notificatie wanneer er nieuwe agendapunten zijn die aan deze filter voldoen"
                        @side="left"
                      />
                    </div>
                  </div>
                  <div
                    class="au-u-flex au-u-flex--between au-u-1-1 border-bottom-light au-u-padding-bottom-small"
                  >
                    <AuButton
                      @skin="link"
                      class="au-u-padding-none au-u-margin-none action-sdk-color"
                      {{on "click" (fn this.loadFilter savedFilter)}}
                    >
                      Toepassen
                    </AuButton>
                    <div
                      class="tooltip-wrapper au-u-flex au-u-margin-left-tiny au-u-flex--end au-u-flex--vertical-center"
                    >
                      <AuIcon @icon="circle-question" @size="large" />
                      <EmberTooltip
                        @text="Deze filter zal toegepast worden"
                        @side="left"
                      />
                    </div>
                  </div>
                  <div class="au-u-flex au-u-flex--between au-u-1-1">
                    <AuButton
                      @skin="link"
                      @alert={{true}}
                      class="au-u-padding-none au-u-margin-none"
                      {{on "click" (fn this.deleteFilter index)}}
                    >
                      Verwijderen
                    </AuButton>
                    <div
                      class="tooltip-wrapper au-u-flex au-u-margin-left-tiny au-u-flex--end au-u-flex--vertical-center"
                    >
                      <AuIcon @icon="circle-question" @size="large" />
                      <EmberTooltip
                        @text="Deze filter zal permanent verwijderd worden"
                        @side="left"
                      />
                    </div>
                  </div>
                </div>
              </c.content>
            </AuCard>
          {{/each}}
        </div>
      {{else}}
        <p class="au-u-text-muted au-u-padding-tiny">Geen filters opgeslagen</p>
      {{/if}}
    </div>
  </:body>
</AuModal>