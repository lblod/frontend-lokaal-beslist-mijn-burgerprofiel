{{page-title "Zitting"}}

<AuToolbar @border="bottom" class="sticky-top" as |Group|>
  <Group>
    <AuButton
      class="au-u-padding au-u-padding-bottom-small link-without-line action-sdk-color"
      @skin="link"
      {{on "click" this.toAgendapunt}}
    >{{this.navigation.backLabel}}</AuButton>
  </Group>
</AuToolbar>

<Session
  @governingBodyName={{this.model.session.governingBodyNameResolved}}
  @sessionDate={{this.model.session.dateFormatted}}
  @sessionAgendaItems={{this.agendaItemsSorted}}
/>